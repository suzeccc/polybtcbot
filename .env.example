# The Settings page can change the saved startup mode; CLI flags override it.
BOT_PAPER_MODE=true
BOT_STRATEGY=btc_momentum_regime
BOT_BANKROLL=100.0

# Position sizing defaults. These can also be changed from Dashboard > Strategy.
BOT_POSITION_MODE=fixed
BOT_FIXED_SIZE_TYPE=usd
BOT_FIXED_POSITION_USD=2.0
BOT_FIXED_POSITION_SHARES=5
# Tilted Pair + Dynamic Exit controls (used only with BOT_STRATEGY=paired_tilt_exit).
BOT_PAIRED_BASE_SHARES=5
BOT_PAIRED_TILT_PCT=10
BOT_PAIRED_MAX_COST_USD=10
BOT_PAIRED_MAX_PRICE=0.65
BOT_PAIRED_TILT_GAP=0.03
BOT_MIN_POSITION_USD=2.0
BOT_MAX_POSITION_USD=5.0
BOT_MAX_HEDGE_USD=30.0
